{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit && tsc --project supabase/tsconfig.json",
    "test": "node --experimental-transform-types --test tests/*.test.ts",
    "test:ui": "vite build --config tests/vite.ui.config.ts && node --test tests/ui.test.mjs"
  },
  "dependencies": {
    "@figma/astraui": "1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^30.1.2",
    "oxfmt": "^0.2.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.3"
  },
  "packageManager": "pnpm@11.25.0"
}
