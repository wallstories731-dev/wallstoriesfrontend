# SERVER ONLY. Set via Supabase secrets, never VITE_* or checked-in .env files.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Exact browser origins; comma-separated. No wildcard. No trailing slash.
ALLOWED_ORIGINS=https://your-domain.example
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase.
