# Backend API Configuration
# Must include the backend context path (CONTEXT_PATH, default /wallstories)
VITE_BACKEND_URL=http://localhost:8080/wallstories

# Payment Configuration
# Options: "off", "mock" (dev only), "razorpay"
VITE_PAYMENT_MODE=razorpay

# Brand Configuration
VITE_BRAND_NAME=Wall Stories

